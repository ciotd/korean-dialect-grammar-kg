{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KG v3 run record draft",
  "type": "object",
  "required": ["run_id", "status", "purpose", "timestamp_utc", "independent_evaluation", "inputs", "conditions", "artifacts", "model", "calls", "evaluation", "limitations"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "running", "completed", "failed", "blocked"]},
    "purpose": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": ["string", "null"]},
    "independent_evaluation": {"type": "boolean"},
    "inputs": {"type": "object", "required": ["count", "unit", "split", "sha256"], "properties": {"count": {"type": ["integer", "null"], "minimum": 0}, "unit": {"type": "string"}, "split": {"enum": ["development", "independent", "not_decided"]}, "sha256": {"type": ["string", "null"]}}},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "object", "required": ["code_commit", "kg_sha256", "requests_sha256", "responses_sha256"]},
    "model": {"type": "object", "required": ["id", "checkpoint", "quantization", "settings"]},
    "calls": {"type": "object", "required": ["analysis", "generation", "retries", "preservation_rechecks", "reused_outputs"], "additionalProperties": {"type": ["integer", "null"], "minimum": 0}},
    "evaluation": {"type": "object", "required": ["status", "quality_scores"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
